{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build console",
            "type": "shell",
            "command": "make console",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "build gui",
            "type": "shell",
            "command": "make gui",
            "problemMatcher": ["$gcc"],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "clean",
            "type": "shell",
            "command": "make clean",
            "problemMatcher": []
        },
        {
            "label": "run console",
            "type": "shell",
            "command": "./build/cafe_console",
            "dependsOn": ["build console"],
            "problemMatcher": []
        },
        {
            "label": "run gui",
            "type": "shell",
            "command": "./build/cafe_gui",
            "dependsOn": ["build gui"],
            "problemMatcher": []
        }
    ]
}
