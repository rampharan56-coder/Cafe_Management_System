{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build cafe",
            "type": "shell",
            "command": "gcc",
            "args": [
                "-Wall",
                "-Wextra",
                "-pedantic",
                "-std=c11",
                "-Iinclude",
                "src/main.c",
                "src/admin.c",
                "src/customer.c",
                "src/menu.c",
                "src/order.c",
                "src/ingredient.c",
                "src/recipe.c",
                "src/analytics.c",
                "src/finance.c",
                "src/recommendation.c",
                "src/fileio.c",
                "src/utils.c",
                "-o",
                "cafe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "clean cafe",
            "type": "shell",
            "command": "rm",
            "args": ["-f", "cafe"],
            "problemMatcher": []
        },
        {
            "label": "run cafe",
            "type": "shell",
            "command": "./cafe",
            "dependsOn": ["build cafe"],
            "problemMatcher": []
        }
    ]
}
